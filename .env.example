# Copy to .env (never commit .env).

# Browser-safe: Project URL and the public ANON key (read-only through RLS policies).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (used by scripts/import-data.js, never by the browser).
# The service-role key bypasses RLS: it must NEVER be prefixed with VITE_ and NEVER be bundled or committed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
